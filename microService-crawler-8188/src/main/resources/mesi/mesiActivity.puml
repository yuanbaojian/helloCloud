@startuml
!theme aws-orange

hide empty description
scale 600 width
[*] --> 无效 : 初始状态

state 无效 {
  [*] --> 无效 : 数据不在缓存中
  无效 --> 独占 : 第一次读取数据\n且无其他处理器拥有
  无效 --> 共享 : 第一次读取数据\n且至少一个其他处理器拥有
}

state 独占 {
  [*] --> 独占 : 仅此处理器拥有\n未修改数据
  独占 --> 修改 : 写入数据
  独占 --> 共享 : 其他处理器请求读取
}

state 共享 {
  [*] --> 共享 : 多个处理器共享\n未修改数据
  共享 --> 无效 : 其他处理器写入数据
  共享 : 其他处理器请求读取\n保持共享
}

state 修改 {
  [*] --> 修改 : 仅此处理器拥有\n已修改数据
  修改 --> 无效 : 其他处理器写入数据
  修改 --> 共享 : 其他处理器请求读取
}

@enduml
